  "cards": [
    {
      "dot": "cyan",
      "title": "Ports (hexagonal)",
      "items": [
        "Transport, VoiceProvider, AgentAdapter, DeviceAction keep providers and devices out of gateway core",
        "AVIP splits media, reliable control, and async events"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gateway core",
      "items": [
        "Session manager + correlation IDs for VoiceSession / VoiceResponse / AgentRun",
        "Capability registry, media router, event routing, run manager, telemetry"
      ]
    },
    {
      "dot": "amber",
      "title": "Skeleton vs target",
      "items": [
        "Today: FastAPI JSON WS + mock agent; session-owned runs cancel on disconnect",
        "Target: Gemini Live + Hermes via ports; durable runs only after all M2 gates",
        "ROS 2 bridge stays client-side; v0.1 mock actions only, no motors"
      ]
    }
  ]

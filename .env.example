# Server-side only. The Live adapter and the spike read GEMINI_API_KEY from the
# process environment. They do not load this file. Never commit a real key.
GEMINI_API_KEY=
# Required only when GEMINI_API_KEY is set. The adapter does not choose a
# default. Use a model code recorded in docs/adr/011-gemini-live-compatibility.md.
GEMINI_LIVE_MODEL=
